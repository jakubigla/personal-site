---
import type { Content } from "../content/schema";

interface Props {
  hero: Content["hero"];
}
const { hero } = Astro.props;
---

<header class="section" id="hero">
  <p>{hero.name} &middot; {hero.role}</p>
  <h1>{hero.headline}</h1>
  <p>{hero.value_statement}</p>
</header>

<style>
  #hero h1 {
    font-size: clamp(2.25rem, 7vw, 4.25rem);
  }
</style>
