== pinned runtimes
# The one place a tool version lives. CI installs from here, so a laptop and a runner match.
[tools]
node = "26.13.1"
terraform = "1.17.2"
tflint = "0.66.0"
pre-commit = "4.7.0"
gitleaks = "8.30.1"

[tasks."web:install"]
description = "Install the web app's packages from the lockfile, scripts off"
dir = "apps/web"
run = "npm ci --ignore-scripts"
