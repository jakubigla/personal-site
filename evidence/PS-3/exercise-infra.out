+ cat -n /Users/jakubigla/Project-Repositories/Personal/personal-site/.claude/worktrees/PS-3/infra/bootstrap/main.tf
     1	# Applied once by hand with local state; creates the bucket every other root keeps its
     2	# state in (ADR-0009). Its own small state file stays on the owner's machine, never committed.
     3	terraform {
     4	  required_version = ">= 1.10"
     5	  required_providers {
     6	    aws = {
     7	      source  = "hashicorp/aws"
     8	      version = "~> 6.74"
     9	    }
    10	  }
    11	}
    12	
    13	provider "aws" {
    14	  region = "eu-central-1"
    15	}
    16	
    17	resource "aws_s3_bucket" "state" {
    18	  bucket = "jacops-pl-terraform-state"
    19	
    20	  lifecycle {
    21	    prevent_destroy = true
    22	  }
    23	}
    24	
    25	resource "aws_s3_bucket_versioning" "state" {
    26	  bucket = aws_s3_bucket.state.id
    27	  versioning_configuration {
    28	    status = "Enabled"
    29	  }
    30	}
    31	
    32	resource "aws_s3_bucket_server_side_encryption_configuration" "state" {
    33	  bucket = aws_s3_bucket.state.id
    34	  rule {
    35	    apply_server_side_encryption_by_default {
    36	      sse_algorithm = "AES256"
    37	    }
    38	  }
    39	}
    40	
    41	resource "aws_s3_bucket_public_access_block" "state" {
    42	  bucket                  = aws_s3_bucket.state.id
    43	  block_public_acls       = true
    44	  block_public_policy     = true
    45	  ignore_public_acls      = true
    46	  restrict_public_buckets = true
    47	}
    48	
    49	resource "aws_s3_bucket_ownership_controls" "state" {
    50	  bucket = aws_s3_bucket.state.id
    51	  rule {
    52	    object_ownership = "BucketOwnerEnforced"
    53	  }
    54	}
    55	
    56	resource "aws_s3_bucket_policy" "state" {
    57	  bucket = aws_s3_bucket.state.id
    58	  policy = jsonencode({
    59	    Version = "2012-10-17"
    60	    Statement = [{
    61	      Sid       = "TlsOnly"
    62	      Effect    = "Deny"
    63	      Principal = "*"
    64	      Action    = "s3:*"
    65	      Resource  = [aws_s3_bucket.state.arn, "${aws_s3_bucket.state.arn}/*"]
    66	      Condition = { Bool = { "aws:SecureTransport" = "false" } }
    67	    }]
    68	  })
    69	
    70	  depends_on = [aws_s3_bucket_public_access_block.state]
    71	}
